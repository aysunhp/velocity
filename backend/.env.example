# --- App ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# --- Data layer ---
# mock | mongo
DATA_SOURCE=mock
MONGO_URI=mongodb://localhost:27017/velocity

# --- Mail (nodemailer) ---
# Leave SMTP_HOST blank in dev to log emails to console instead of sending
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
MAIL_FROM="Velocity <xipiyevaaysun@gmail.com>"
ADMIN_EMAIL=xipiyevaaysun@gmail.com
MAIL_TO=bookings@velocity.example

# --- Rate limit ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
